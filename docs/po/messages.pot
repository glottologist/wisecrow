msgstr ""

#: src/guides/preview-subtitles.md:25
msgid ""
"Path to the subtitle file. Format inferred from extension: `.vtt`, `.ass`, "
"`.ssa`, or default to SRT."
msgstr ""

#: src/guides/preview-subtitles.md:26
msgid "Native language code (used by `--gloss-unknowns`)."
