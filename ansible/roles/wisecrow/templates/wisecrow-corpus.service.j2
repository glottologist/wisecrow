[Unit]
Description=Wisecrow corpus ingest, ranking, and word media
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory={{ deploy_dir }}
ExecStart=/bin/bash {{ deploy_dir }}/scripts/prepare-corpus.sh
Restart=on-success
RestartSec=1

[Install]
WantedBy=multi-user.target
