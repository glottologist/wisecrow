WISECROW__LLM_MODEL={{ llm_model }}
{% endif %}
{% endif %}
{% if image_provider | default('') %}
WISECROW__IMAGE_PROVIDER={{ image_provider }}
{% endif %}
{% if unsplash_api_key | default('') %}
WISECROW__UNSPLASH_API_KEY={{ unsplash_api_key }}
{% endif %}
{% if pexels_api_key | default('') %}
WISECROW__PEXELS_API_KEY={{ pexels_api_key }}
{% endif %}
{% if pixabay_api_key | default('') %}
